<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_robot_depth_navigation</name>
  <version>0.0.0</version>
  <description>
    This package enhances ai signals detection by adding depth scanning capabilities
    thanks to the LIMO's depth camera.
  </description>
  <maintainer email="johnnyastudilloso@gmail.com">neorefraction</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_simple_commander</depend>
  <depend>tf_transformations</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>vision_msgs</depend>
  <depend>custom_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
